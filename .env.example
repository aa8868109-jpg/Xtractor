# Firebase credentials for Vercel serverless functions.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Alternative: use one JSON value instead of the three variables above.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}